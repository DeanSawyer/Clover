<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
	  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<target name="colouredConsole" xsi:type="ColoredConsole" />
		<target name="chatFile" xsi:type="File" fileName="${basedir}/Logs/Chat-${shortdate}.log" />
		<target name="auditFile" xsi:type="File" fileName="${basedir}/Logs/Audit-${shortdate}.log" />
		<target name="infoFile" xsi:type="File" fileName="${basedir}/Logs/${processname}-Info-${shortdate}.log" />
		<target name="errorFile" xsi:type="File" fileName="${basedir}/Logs/${processname}-Error-${shortdate}.log" />
		<target name="eyeFile" xsi:type="File" fileName="${basedir}/Logs/Eye/Eye-Gateway-${shortdate}.jsonl">
			<layout xsi:type="JsonLayout">
				<attribute name="t" layout="${date:universalTime=true:format=o}" />
				<attribute name="src" layout="${logger}" />
				<attribute name="lvl" layout="${level}" />
				<attribute name="eye" layout="${event-properties:item=EyeJson}" encode="false" />
				<attribute name="msg" layout="${when:when=logger!='Eye':inner=${message}}" />
				<attribute name="err" layout="${exception:format=tostring}" />
			</layout>
		</target>
	</targets>
	<rules>
		<logger name="Microsoft.EntityFrameworkCore.*" maxLevel="Warn" final="true" />
		<logger name="Eye" minlevel="Trace" writeTo="eyeFile" final="true" />
		<logger name="*" minlevel="Warn" writeTo="eyeFile" />

		<logger name="Chat" writeTo="chatFile" final="true" />
		<logger name="Audit" writeTo="auditFile" final="true" />
		<logger name="*" minlevel="Info" writeTo="colouredConsole" />
		<logger name="*" minlevel="Info" maxlevel="Info" writeTo="infoFile" />
		<logger name="*" minlevel="Warn" maxlevel="Fatal" writeTo="errorFile" />
	</rules>
</nlog>